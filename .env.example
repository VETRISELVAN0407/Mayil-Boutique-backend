# Copy the SMS section into backend/.env (loaded by spring-dotenv). Never commit real values.

# OTP delivery: none (default, OTP requests fail with 503) | msg91 | log (local dev only, prints OTP to console) | dummy (TEMPORARY test mode: the OTP is shown on the login page, nothing is sent; the app refuses to start with the prod profile). Set msg91 again for real delivery.
SMS_PROVIDER=msg91
# MSG91 dashboard -> Authkey
MSG91_AUTH_KEY=
# MSG91 dashboard -> OTP -> Templates (the DLT-approved template ID)
MSG91_TEMPLATE_ID=
# Optional, defaults to 91 (India)
MSG91_COUNTRY_CODE=91

# Product images: folder OUTSIDE the project (created on first upload). Default: <user home>/mayil-boutique/product-images
# Windows dev:  PRODUCT_IMAGE_DIR=D:/mayil-data/product-images   (forward slashes work)
# Production:   PRODUCT_IMAGE_DIR=/var/lib/mayil-boutique/product-images  (must be writable by the app user, on persistent storage)
# BACK UP THIS FOLDER together with the PostgreSQL database: the DB holds only filenames, so a DB restore without the folder loses every image.
PRODUCT_IMAGE_DIR=
# Per-image limit in bytes (default 5 MB). If raised above ~5.9 MB also raise PRODUCT_IMAGE_MAX_REQUEST_SIZE (default 6MB).
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_REQUEST_SIZE=6MB

# Virtual Try-On (off until an AI provider is connected). Customer photos go to a PRIVATE temporary folder (not served, no backup needed).
TRYON_ENABLED=false
TRYON_TMP_DIR=
TRYON_RETENTION_MINUTES=30
# Engine: none (default) | selfhosted (tryon-service/) | fashn (hosted fashn.ai: key in TRYON_SERVICE_API_KEY, leave TRYON_SERVICE_URL blank)
TRYON_PROVIDER=none
TRYON_SERVICE_URL=
TRYON_SERVICE_API_KEY=
# Optional: what one successful preview costs you (INR); shown as an estimate in the admin Virtual Try-On page.
TRYON_COST_PER_JOB=0

# Browser origins allowed to call the API from another domain (comma separated, no trailing slash), e.g. https://your-shop.vercel.app. Leave empty for local dev (Vite proxy).
CORS_ALLOWED_ORIGINS=
